<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hsc.ivr.mapper.IvrSatisfactionRecordMapper">

    <!-- dashboard-analytics-revamp: 满意度按评分聚合（score>0 计入，0-未评价排除） -->
    <select id="statByScore" resultType="java.util.HashMap">
        SELECT score,
               COUNT(*) AS cnt
        FROM ivr_satisfaction_record
        WHERE del_flag = 0
          AND score &gt; 0
          AND create_time &gt;= #{begin}
          AND create_time &lt; #{end}
        GROUP BY score
    </select>
</mapper>

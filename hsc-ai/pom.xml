        <!-- 通用 OpenAI 兼容客户端（动态 baseUrl+model+apiKey，平迁 rb LlmClientUtil）。
             供 model_config 表管理的动态模型调用：摘要/关键词/翻译等结构化任务。 -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>1.4.1</version>
        </dependency>


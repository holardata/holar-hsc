    <groupId>com.hsc</groupId>
    <artifactId>hsc-system</artifactId>
    <version>0.0.1</version>
    <name>hsc-system</name>
    <description>hsc-system</description>

    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>

        <dependency>
            <groupId>com.hsc</groupId>
            <artifactId>hsc-common</artifactId>
            <version>0.0.1</version>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-http</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>

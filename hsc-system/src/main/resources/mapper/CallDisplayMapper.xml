<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hsc.system.mapper.CallDisplayMapper">

    <resultMap type="com.hsc.system.domain.vo.display.CallDisplayVo" id="CallDisplayMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="phone" column="phone" jdbcType="VARCHAR"/>
        <result property="area" column="area" jdbcType="VARCHAR"/>
        <result property="createBy" column="create_by" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="INTEGER"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="selectCallDisplayVo">
        select id,  phone, area, create_by, create_time, update_by, update_time, del_flag from call_display
    </sql>

    <select id="getList" resultMap="CallDisplayMap">
        <include refid="selectCallDisplayVo"/>
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="phone != null and phone != ''">
                and phone = #{phone}
            </if>
            and del_flag = 0
        </where>
        order by id desc
    </select>

</mapper>

